model Analysis {
    id                Int      @id @default(autoincrement())
    analysis_run_name String   @unique
    dateSubmitted     DateTime @default(now())
    isPrivate         Boolean
    trusted           Boolean
    /// [EditHistoryType]
    editHistory       Json?

    // Relations
    project_id       String
    Project          Project          @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
    assay_name       String
    Assay            Assay            @relation(fields: [assay_name], references: [assay_name])
    Occurrences      Occurrence[]
    Assignments      Assignment[]
    Tags             Tag[]
    AlphaDiversities AlphaDiversity[]

    // Submission File URLs
    analysisMetadataFileUrl_ODE      String
    analysisMetadataFileChecksum_ODE String
    asvFileUrl_ODE                   String
    asvFileChecksum_ODE              String
    occurrenceFileUrl_ODE            String
    occurrenceFileChecksum_ODE       String

    // Data
    // Bioinformatics
    sop_bioinformatics                   String?
    trim_method                          String?
    trim_param                           String?
    demux_tool                           String?
    demux_max_mismatch                   Int?
    merge_tool                           String?
    merge_min_overlap                    Int?
    min_len_cutoff                       Int?
    min_len_tool                         String?
    error_rate_tool                      String?
    error_rate_type                      String?
    error_rate_cutoff                    Float?
    chimera_check_method                 String?
    chimera_check_param                  String?
    otu_clust_tool                       String?
    otu_clust_cutoff                     Float?
    min_reads_cutoff                     Float?
    min_reads_cutoff_unit                String?
    min_reads_tool                       String?
    otu_db                               String? //[]     @default([])
    otu_db_custom                        String? //[]     @default([])
    tax_assign_cat                       String?
    otu_seq_comp_appr                    String?
    tax_class_id_cutoff                  Float?
    tax_class_query_cutoff               Float?
    tax_class_collapse                   String?
    tax_class_other                      String?
    screen_contam_method                 String?
    screen_geograph_method               String?
    screen_nontarget_method              String?
    screen_other                         String?
    bioinfo_method_additional            String?
    asv_method                           String?
    dada2_trunc_len_f                    Int?
    dada2pe_trunc_len_r                  Int?
    dada2_trim_left_f                    Int?
    dada2pe_trim_left_r                  Int?
    dada2_max_ee_f                       Int?
    dada2pe_max_ee_r                     Int?
    dada2_trunc_q                        Int?
    dada2_pooling_method                 String?
    dada2_chimera_method                 String?
    dada2_min_fold_parent_over_abundance Int?
    dada2_n_reads_learn                  Int?
    deblur_trim_length                   Int?
    deblur_mean_error                    Float?
    deblur_indel_prob                    Float?
    deblur_indel_max                     Int?
    deblur_min_reads                     Int?
    deblur_min_size                      Int?
    repseqs_min_length                   Int?
    repseqs_max_length                   Int?
    repseqs_min_abundance                Float?
    repseqs_min_prevalence               Float?
    discard_untrimmed                    DeadBoolean?
    otu_num_tax_assigned                 Int?
    output_otu_num                       Int?
    output_read_count                    Int?
    otu_final_description                String?
    otu_raw_description                  String?
    qiime2_version                       String?
    tourmaline_asv_method                String?
    skl_confidence                       Float?
    min_consensus                        Float?
    tourmaline_classify_method           String?
    blca_confidence                      Float?

    // OTU/ASV
    percent_match                    Float?
    percent_match_Midpoint_ODE       Float?
    percent_match_End_ODE            Float?
    percent_query_cover              Float?
    percent_query_cover_Midpoint_ODE Float?
    percent_query_cover_End_ODE      Float?
}

model Occurrence {
    id Int @id @default(autoincrement())

    // Relations
    lib_id            String
    Library           Library    @relation(fields: [lib_id], references: [lib_id], onDelete: Cascade)
    analysis_run_name String
    Analysis          Analysis   @relation(fields: [analysis_run_name], references: [analysis_run_name], onDelete: Cascade)
    featureid         String
    Feature           Feature    @relation(fields: [featureid], references: [featureid], onDelete: Cascade)
    Assignment        Assignment @relation(fields: [analysis_run_name, featureid], references: [analysis_run_name, featureid], onDelete: Cascade)

    // Data
    organismQuantity Int

    @@unique([analysis_run_name, lib_id, featureid])
    @@index(fields: [analysis_run_name, featureid])
}

model Assignment {
    id Int @id @default(autoincrement())

    // Relations
    analysis_run_name String
    Analysis          Analysis     @relation(fields: [analysis_run_name], references: [analysis_run_name], onDelete: Cascade)
    featureid         String
    Feature           Feature      @relation(fields: [featureid], references: [featureid], onDelete: Cascade)
    taxonomy          String
    Taxonomy          Taxonomy     @relation(fields: [taxonomy], references: [taxonomy], onDelete: Cascade)
    Occurrences       Occurrence[]

    // Data
    Confidence Float

    @@unique([analysis_run_name, featureid])
}

model Feature {
    id        Int    @id @default(autoincrement())
    featureid String @unique

    // Relations
    Occurrences Occurrence[]
    Assignments Assignment[]

    // Data
    dna_sequence       String
    sequenceLength_ODE Int
}

model Taxonomy {
    id       Int    @id @default(autoincrement())
    taxonomy String @unique

    // Relations
    Assignments Assignment[]

    // Data
    verbatimIdentification String
    higherClassification   String?
    kingdom                String?
    phylum                 String?
    class                  String?
    order                  String?
    family                 String?
    genus                  String?
    species                String?
}

model Tag {
    id      Int    @id @default(autoincrement())
    tagName String @unique

    // Relations
    Analyses Analysis[]

    description String
    color       String
}

model AlphaDiversity {
    id             Int      @id @default(autoincrement())
    dateCalculated DateTime @default(now())
    finished       Boolean  @default(false)

    // Relations
    analysis_run_name     String
    Analysis              Analysis              @relation(fields: [analysis_run_name], references: [analysis_run_name], onDelete: Cascade)
    AlphaDiversityIndexes AlphaDiversityIndex[]

    indexType String
    rarefied  Boolean
    depth     Int?
}

model AlphaDiversityIndex {
    id Int @id @default(autoincrement())

    // Relations
    lib_id         String
    Library        Library        @relation(fields: [lib_id], references: [lib_id], onDelete: Cascade)
    parentId       Int
    AlphaDiversity AlphaDiversity @relation(fields: [parentId], references: [id], onDelete: Cascade)

    index Float
}
