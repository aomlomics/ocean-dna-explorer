datasource images_db {
    provider = "postgresql"
}

generator images_client {
    provider            = "prisma-client"
    output              = "../app/generated/prismaImages"
    runtime             = "edge-light"
    importFileExtension = ""
}

generator images_zod {
    provider                         = "zod-prisma-types"
    prismaClientPath                 = "@/app/generated/prismaImages"
    createInputTypes                 = false
    addIncludeType                   = false
    addSelectType                    = false
    writeNullishInModelTypes         = true
    createOptionalDefaultValuesTypes = true
    createRelationValuesTypes        = true
    createPartialTypes               = true
}

model Image {
    id            Int      @id @default(autoincrement())
    dateSubmitted DateTime @default(now())
    name          String   @unique
    url           String   @unique
    userId        String   @default("")
    homePage      Boolean  @default(true)

    //relations
    attributionTitle String?
    Attribution      Attribution? @relation(fields: [attributionTitle], references: [attributionTitle])

    description String?
    location    String?
    dateTaken   DateTime?
}

model Attribution {
    id               Int    @id @default(autoincrement())
    attributionTitle String @unique

    //relations
    Image Image[]

    attributionNames       String[] @default([])
    attributionUrl         String?
    attributionInstitution String?
}

model BlobFile {
    id     Int    @id @default(autoincrement())
    url    String @unique
    userId String
}
