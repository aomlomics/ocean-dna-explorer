{
	"private": true,
	"prisma": {
		"schema": "./prisma"
	},
	"prettier": {
		"printWidth": 120,
		"trailingComma": "none",
		"useTabs": true,
		"semi": true,
		"singleQuote": false,
		"jsxSingleQuote": false,
		"bracketSpacing": true,
		"arrowParens": "always",
		"endOfLine": "lf"
	},
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "npm run lint && next build",
		"start": "next start",
		"lint": "eslint .",
		"generate": "npx prisma generate && npx prisma generate --schema ./prismaImages/schema.prisma --config ./prismaImages/prisma.config.ts",
		"migrate": "npx prisma migrate deploy && npx prisma migrate deploy --schema ./prismaImages/schema.prisma --config ./prismaImages/prisma.config.ts",
		"postinstall": "npm run migrate && npm run generate",
		"format": "npx prettier --write .",
		"check": "npx prettier --check . && npm run lint && echo Running TypeScript... && tsc --noEmit --skipLibCheck && echo Finished TypeScript"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.5.2",
		"@hookform/resolvers": "^5.4.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@sgratzl/chartjs-chart-boxplot": "^4.4.5",
		"@types/eslint": "^9.6.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.5.0",
		"autoprefixer": "10.5.2",
		"chart.js": "^4.5.1",
		"chartjs-adapter-date-fns": "^3.0.0",
		"chartjs-plugin-zoom": "^2.2.0",
		"chroma-js": "^3.2.0",
		"cobe": "^2.0.1",
		"cssnano": "^7.1.7",
		"csv-parse": "^6.2.1",
		"date-fns": "^4.4.0",
		"distinct-colors": "^3.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.1",
		"eslint-config-next": "16.2.10",
		"formidable": "^3.5.4",
		"framer-motion": "^12.38.0",
		"js-md5": "^0.8.3",
		"json5": "^2.2.3",
