		"next-themes": "^0.4.6",
		"object-to-formdata": "^4.5.1",
		"postcss": "^8.5.16",
		"react": "19.2.7",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.78.0",
		"react-leaflet": "^5.0.0",
