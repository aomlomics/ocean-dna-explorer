{
  "private": true,
  "prisma": {
    "schema": "./prisma"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "none",
    "useTabs": true,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx tsx prisma/seed.ts",
    "generate": "npx prisma generate && npx prisma generate --schema ./prismaImages/schema.prisma",
    "postinstall": "npx prisma migrate deploy && npx prisma generate && npx prisma migrate deploy --schema ./prismaImages/schema.prisma && npx prisma generate --schema ./prismaImages/schema.prisma",
    "postbuild": "npx tsx ./sitemap-index.ts && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.6",
    "@clerk/themes": "^2.4.27",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.17.1",
    "@types/node": "24.8.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/blob": "^2.0.0",
    "@vercel/postgres": "^0.10.0",
    "autoprefixer": "10.4.21",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.1",
    "csv-parse": "^6.1.0",
    "distinct-colors": "^3.0.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.6",
    "formidable": "^3.5.4",
    "js-md5": "^0.8.3",
    "json5": "^2.2.3",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.5.6",
    "next-themes": "^0.4.6",
    "object-to-formdata": "^4.5.1",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-draw-next": "^1.0.3",
    "react-leaflet-fullscreen": "github:eYdr1en/react-leaflet-fullscreen",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-syntax-highlighter": "^15.6.6",
    "swr": "^2.3.6",
    "typescript": "5.9.3",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.12",
    "zod-prisma-types": "^3.3.5"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/density-clustering": "^1.3.3",
    "@types/leaflet": "^1.9.21",
    "daisyui": "^5.3.7",
    "prisma": "^6.17.1",
    "prisma-erd-generator": "^2.1.0",
    "prisma-json-types-generator": "^3.6.2",
    "puppeteer": "^23.11.1",
    "tailwind-scrollbar": "^4.0.2"
  }
}
