{
  "private": true,
  "prisma": {
    "schema": "./prisma"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "none",
    "useTabs": true,
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node prisma/seed.ts",
    "generate": "npx prisma generate && npx prisma generate --schema ./prismaImages/schema.prisma",
    "postinstall": "npx prisma migrate deploy && npx prisma generate && npx prisma migrate deploy --schema ./prismaImages/schema.prisma && npx prisma generate --schema ./prismaImages/schema.prisma",
    "postbuild": "npx tsx ./sitemap-index.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.25.4",
    "@clerk/themes": "^2.3.3",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.11.0",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/blob": "^1.1.1",
    "@vercel/postgres": "^0.10.0",
    "autoprefixer": "10.4.21",
    "chart.js": "^4.5.0",
    "concurrently": "^9.2.0",
    "cssnano": "^7.1.0",
    "csv-parse": "^5.6.0",
    "density-clustering": "^1.3.0",
    "distinct-colors": "^3.0.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "15.4.2",
    "formidable": "^3.5.4",
    "json5": "^2.2.3",
    "leaflet": "^1.9.4",
    "next": "^15.4.2",
    "next-themes": "^0.4.6",
    "object-to-formdata": "^4.5.1",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.60.0",
    "react-leaflet": "^5.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "swr": "^2.3.4",
    "typescript": "5.8.3",
    "use-debounce": "^10.0.5",
    "zod": "^3.24.4",
    "zod-prisma-types": "^3.2.4"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.6.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/density-clustering": "^1.3.3",
    "@types/leaflet": "^1.9.20",
    "daisyui": "^5.0.46",
    "prisma": "^6.11.0",
    "prisma-erd-generator": "^2.0.4",
    "prisma-json-types-generator": "^3.5.1",
    "puppeteer": "^23.11.1",
    "tailwind-scrollbar": "^4.0.2"
  }
}
