{
	"entryPoints": ["app", "types"],
	"entryPointStrategy": "expand",
	"exclude": [
		"**/route.ts",
		"**/page.tsx",
		"**/layout.tsx",
		"**/loading.tsx",
		"**/error.tsx",
		"**/not-found.tsx",
		"**/sitemap.ts",
		"app/generated/**",
		"app/global-error.tsx",
		"app/manifest.ts",
		"app/robots.ts"
	],
	"out": "docs",
	"highlightLanguages": ["typescript", "sql", "bash"],
	"validation": {
		"notExported": false
	},
	"excludeExternals": true,
	"useTsLinkResolution": true,
	"includeDocCommentReferences": true,
	"placeInternalsInOwningModule": true,
	"plugin": ["typedoc-plugin-missing-exports"]
}
